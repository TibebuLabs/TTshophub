# Copy to .env and replace placeholders with private values.
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
ADMIN_INVITE_CODE=REPLACE_WITH_A_PRIVATE_ADMIN_INVITE_CODE
WEB_ORIGIN=http://localhost:3000,http://localhost:3001

# Supabase Storage: use the project URL and a server-side secret key only.
# Never put SUPABASE_SECRET_KEY in frontend or NEXT_PUBLIC_ variables.
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_SECRET_KEY=REPLACE_WITH_THE_SUPABASE_SECRET_KEY

# Supabase Dashboard > Project > Connect. Keep connection strings server-side.
# DATABASE_URL is for the running services; DIRECT_URL is for migrations.
# Replace the example URIs with your project's values; never commit real URIs.
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_URL_ENCODED_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require
DIRECT_URL=postgresql://postgres.PROJECT_REF:YOUR_URL_ENCODED_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require

# Optional: path to the PEM CA certificate downloaded for this project from
# Supabase Dashboard > Project Settings > Database > SSL Configuration.
# The file must not be empty; do not use a CA certificate from another project.
# Relative paths resolve from the backend directory.
# DATABASE_SSL_CA_PATH=./certs/supabase-ca.crt

# Tables are created by CREATE_ALL_TABLES.sql. Keep synchronization disabled
# so TypeORM never makes unreviewed schema changes to the Supabase database.
DB_SYNCHRONIZE=false

PORT=4000
AUTH_HOST=localhost
AUTH_PORT=4001
CATALOG_HOST=localhost
CATALOG_PORT=4002
ORDER_HOST=localhost
ORDER_PORT=4003
NOTIFY_HOST=localhost
NOTIFY_PORT=4004
GATEWAY_HOST=localhost
GATEWAY_TCP_PORT=4010
