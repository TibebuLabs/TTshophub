{
  "name": "nilemart-backend",
  "version": "1.0.0",
  "private": true,
  "description": "NileMart – NestJS microservices (api-gateway, auth, catalog, order, notification)",
  "scripts": {
    "build": "nest build api-gateway && nest build auth-service && nest build catalog-service && nest build order-service && nest build notification-service",
    "dev": "concurrently -n gateway,auth,catalog,orders,notify -c blue,green,yellow,magenta,cyan \"npm:dev:gateway\" \"npm:dev:auth\" \"npm:dev:catalog\" \"npm:dev:orders\" \"npm:dev:notify\"",
    "dev:gateway": "nest start api-gateway --watch",
    "dev:auth": "nest start auth-service --watch",
    "dev:catalog": "nest start catalog-service --watch",
    "dev:orders": "nest start order-service --watch",
    "dev:notify": "nest start notification-service --watch",
    "db:check": "node test-db-connection.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "migration:generate": "typeorm-ts-node-commonjs migration:generate -d ormconfig.ts",
    "migration:run": "typeorm-ts-node-commonjs migration:run -d ormconfig.ts",
    "migration:revert": "typeorm-ts-node-commonjs migration:revert -d ormconfig.ts",
    "migration:show": "typeorm-ts-node-commonjs migration:show -d ormconfig.ts",
    "seed": "ts-node apps/catalog-service/src/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/mapped-types": "^2.0.5",
    "@nestjs/microservices": "^10.4.0",
    "@nestjs/platform-express": "^10.4.0",
    "@nestjs/typeorm": "^10.0.2",
    "@supabase/supabase-js": "^2.117.3",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^16.4.5",
    "kafkajs": "^2.2.4",
    "pg": "^8.12.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.5",
    "@nestjs/schematics": "^10.1.4",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "concurrently": "^8.2.2",
    "ts-loader": "^9.5.1",
    "typescript": "^5.5.4"
  }
}
